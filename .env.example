# =========================================================
# 複製此檔案為 .env，填入實際值後即可本機啟動
# 部署到 Cloud Run 時透過 deploy.sh 的 --set-env-vars 傳入
# =========================================================

# 【必填】OpenAI API Key
OPENAI_API_KEY=sk-...

# 【選填】開啟 LangChain 偵錯 log（本機開發用，Cloud Run 建議保持預設 false）
# LANGCHAIN_DEBUG=true
